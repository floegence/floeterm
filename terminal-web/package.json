{
  "name": "@floegence/floeterm-terminal-web",
  "version": "0.15.7",
  "description": "Framework-neutral semantic terminal renderer, input bridge, live transport, and session metadata utilities.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/floegence/floeterm.git",
    "directory": "terminal-web"
  },
  "bugs": {
    "url": "https://github.com/floegence/floeterm/issues"
  },
  "homepage": "https://github.com/floegence/floeterm#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sessions": {
      "types": "./dist/entries/sessions.d.ts",
      "import": "./dist/entries/sessions.js"
    },
    "./live": {
      "types": "./dist/entries/live.d.ts",
      "import": "./dist/entries/live.js"
    },
    "./semantic": {
      "types": "./dist/entries/semantic.d.ts",
      "import": "./dist/entries/semantic.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THEME_PROVENANCE.json",
    "THEME_QUALITY_EVIDENCE.json",
    "THIRD_PARTY_THEME_NOTICES.md",
    "third_party_licenses"
  ],
  "sideEffects": [
    "dist/styles/*.css"
  ],
  "scripts": {
    "build": "node -e \"const fs=require('fs'); fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node -e \"const fs=require('fs'); if (fs.existsSync('src/styles')) fs.cpSync('src/styles', 'dist/styles', { recursive: true })\"",
    "check:semantic-only": "node --test ../scripts/semantic_only_boundary.test.mjs",
    "check:package-artifact": "node scripts/check-package-artifact.mjs",
    "test": "npm run check:semantic-only && vitest run",
    "test:browser": "node scripts/runVitestBrowser.mjs",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm test && npm run test:browser && npm run build && npm run check:package-artifact"
  },
  "keywords": [
    "terminal",
    "ghostty",
    "semantic-terminal",
    "pty",
    "websocket",
    "shell"
  ],
  "dependencies": {},
  "overrides": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "jsdom": "^24.1.3",
    "playwright": "^1.57.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.16",
    "vitest": "4.1.10"
  }
}

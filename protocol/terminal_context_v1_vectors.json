  "stateCases": [
    {
      "name": "same-value replace preserves work epoch",
      "payloads": [
        "633;P;FloetermContext=v1;action=push;frame_id=agent-a;application=agent_cli;identity=codex",
        "633;P;FloetermWork=v1;frame_id=agent-a;phase=working",
        "633;P;FloetermContext=v1;action=replace;frame_id=agent-a;application=agent_cli;identity=codex"
      ],
      "expected": { "contextRevision": 3, "workRevision": 1, "workPhase": "working", "topFrameId": "agent-a", "depth": 3 }
    },
    {
      "name": "duplicate non-top frame cannot displace top",
      "payloads": [
        "633;P;FloetermContext=v1;action=push;frame_id=agent-a;application=agent_cli;identity=codex",
        "633;P;FloetermContext=v1;action=push;frame_id=agent-b;application=agent_cli;identity=codex",
        "633;P;FloetermContext=v1;action=push;frame_id=agent-a;application=agent_cli;identity=codex",
        "633;P;FloetermWork=v1;frame_id=agent-b;phase=working"
      ],
      "expected": { "contextRevision": 4, "workRevision": 1, "workPhase": "working", "topFrameId": "agent-b", "depth": 4 }
    },
    {
      "name": "delayed ABA pop cannot remove restored parent",
      "payloads": [
        "633;P;FloetermContext=v1;action=push;frame_id=agent-a;application=agent_cli;identity=codex",
        "633;P;FloetermContext=v1;action=push;frame_id=agent-b;application=agent_cli;identity=codex",
        "633;P;FloetermContext=v1;action=pop;frame_id=agent-b",
        "633;P;FloetermContext=v1;action=pop;frame_id=agent-b",
        "633;P;FloetermWork=v1;frame_id=agent-a;phase=waiting_user"
      ],
      "expected": { "contextRevision": 5, "workRevision": 1, "workPhase": "waiting_user", "topFrameId": "agent-a", "depth": 3 }
    },
    {
      "name": "stale work is fenced to the top frame",
      "payloads": [
        "633;P;FloetermContext=v1;action=push;frame_id=agent-a;application=agent_cli;identity=codex",
        "633;P;FloetermContext=v1;action=push;frame_id=agent-b;application=agent_cli;identity=codex",
        "633;P;FloetermWork=v1;frame_id=agent-a;phase=working"
      ],
      "expected": { "contextRevision": 4, "workRevision": 0, "workPhase": "unknown", "topFrameId": "agent-b", "depth": 4 }
    },
    {
      "name": "identity replace fails closed",
      "payloads": [
        "633;P;FloetermContext=v1;action=push;frame_id=agent-a;application=agent_cli;identity=codex",
        "633;P;FloetermContext=v1;action=replace;frame_id=agent-a;application=agent_cli;identity=claude"
      ],
      "expected": { "contextRevision": 3, "workRevision": 0, "workPhase": "unknown", "topFrameId": "agent-a", "depth": 3 }
    },
    {
      "name": "frame capacity rejects overflow",
      "payloads": [
        "633;P;FloetermContext=v1;action=push;frame_id=f01;application=shell",
        "633;P;FloetermContext=v1;action=push;frame_id=f02;application=shell",
        "633;P;FloetermContext=v1;action=push;frame_id=f03;application=shell",
        "633;P;FloetermContext=v1;action=push;frame_id=f04;application=shell",
        "633;P;FloetermContext=v1;action=push;frame_id=f05;application=shell",
        "633;P;FloetermContext=v1;action=push;frame_id=f06;application=shell",
        "633;P;FloetermContext=v1;action=push;frame_id=f07;application=shell",
        "633;P;FloetermContext=v1;action=push;frame_id=f08;application=shell",
        "633;P;FloetermContext=v1;action=push;frame_id=f09;application=shell",
        "633;P;FloetermContext=v1;action=push;frame_id=f10;application=shell",
        "633;P;FloetermContext=v1;action=push;frame_id=f11;application=shell",
        "633;P;FloetermContext=v1;action=push;frame_id=f12;application=shell",
        "633;P;FloetermContext=v1;action=push;frame_id=f13;application=shell",
        "633;P;FloetermContext=v1;action=push;frame_id=f14;application=shell",
        "633;P;FloetermContext=v1;action=push;frame_id=overflow;application=shell"
      ],
      "expected": { "contextRevision": 16, "workRevision": 0, "workPhase": "unknown", "topFrameId": "f14", "depth": 16 }
    }
  ],
